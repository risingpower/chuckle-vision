  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.0"
