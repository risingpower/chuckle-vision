{
  "name": "chuckle-vision",
  "private": true,
  "version": "0.1.0",
  "description": "A wordless two-player camera icebreaker game",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-assets.mjs",
